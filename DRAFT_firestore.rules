rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isVerified() { return request.auth.token.email_verified == true; }

    // --- Domain Helpers ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'nombre', 'apellido', 'cedula', 'edad', 'telefono', 'direccion', 'municipio', 'consejoComunal', 'role', 'createdAt', 'updatedAt'])
        && data.keys().size() == 12
        && data.uid == request.auth.uid
        && data.email == request.auth.token.email
        && data.cedula is string && data.cedula.size() >= 5 && data.cedula.size() <= 20
        && data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 50
        && data.edad is int && data.edad >= 18 && data.edad <= 120
        && data.role in ['user', 'admin']
        && data.createdAt == request.time;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['userId', 'loginAt', 'date'])
        && data.userId == request.auth.uid
        && data.loginAt == request.time
        && data.date is string && data.date.size() == 10;
    }

    // --- Rules ---

    // USERS Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isVerified() && isValidUser(incoming());
      allow update: if isOwner(userId) && isVerified() 
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Edit Profile
          incoming().diff(existing()).affectedKeys().hasOnly(['nombre', 'apellido', 'edad', 'telefono', 'direccion', 'municipio', 'consejoComunal', 'updatedAt'])
        );
    }

    // SESSIONS Collection
    match /sessions/{sessionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isVerified() && isValidSession(incoming());
      allow update: if isSignedIn() && isVerified() && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().loginAt == existing().loginAt
        && (
          // Action: Logout
          incoming().diff(existing()).affectedKeys().hasOnly(['logoutAt', 'durationSeconds'])
          && incoming().logoutAt == request.time
          && incoming().durationSeconds is int
        );
    }
  }
}
